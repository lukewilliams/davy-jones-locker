# compose's own settings, read for the ${...} in compose.yaml. Copy to .env
# beside compose.yaml (never committed). The engine's settings are in
# engine/.env, not here.

# Local development. true: the engine may sign no one in (IDENTITY=none, the
# default there). Keep such an engine on your own machine. false (or unset):
# the engine counts as deployed, and starts only with sign-in (IDENTITY in
# engine/.env). Exactly `true` or `false`.
IS_LOCAL=true

# The node worker's way out. none: the app's node kinds reach the engine and
# nothing else. open: any host (the worker joins `outside-open`), for kinds
# that call web services; local development only (IS_LOCAL=true), or the
# engine refuses to start. Exactly `none` or `open`.
NODE_NETWORK=none

# The address the engine's port (9001) is published on. 127.0.0.1: this
# machine only. Change it only with sign-in on (IS_LOCAL=false, or IDENTITY
# set in engine/.env).
ENGINE_BIND=127.0.0.1
