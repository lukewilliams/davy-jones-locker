# compose's own settings, read for the ${...} in compose.yaml. Copy to .env
# beside compose.yaml (never committed). The engine's settings are in
# engine/.env, not here.

# Local development. true: the engine may sign no one in (IDENTITY=none, the
# default there), and the app's node kinds can reach the network (the node
# worker joins `outside-true`). Keep such an engine on your own machine.
# false (or unset): the engine counts as deployed, and starts only with
# sign-in (IDENTITY in engine/.env). Exactly `true` or `false`.
IS_LOCAL=true
