# compose's own settings, read for the ${...} in compose.yaml. Copy to .env
# beside compose.yaml (never committed). The engine's settings are in
# engine/.env, not here.

# Local development. true: the engine starts, signs no one in, and the app's
# node kinds can reach the network (the node worker joins `outside-true`).
# Keep such an engine on your own machine. false (or unset): the engine counts
# as deployed, which requires sign-in, which it doesn't have yet, so it
# refuses to start. Exactly `true` or `false`.
IS_LOCAL=true
