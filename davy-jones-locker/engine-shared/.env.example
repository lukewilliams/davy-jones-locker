# engine-shared's settings. Copy to .env (which isn't committed). The passwords
# are for local development: change them anywhere else, and keep the engine's
# .env in step (its DATABASE_URL and QUERY_DATABASE_URL use the two below).
# They take effect when the database is first created: after that, change them
# with ALTER ROLE, or start over with `docker compose -f davy-jones-locker/engine-shared/compose.yaml down -v`.

# Postgres's superuser.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev

# The engine's database (owned by ENGINE_USER, which creates its tables) and
# the read-only role its SQL nodes query through. Name them for your app.
ENGINE_DB=flow
ENGINE_USER=engine
ENGINE_PASSWORD=engine-dev
ENGINE_READER=engine_reader
ENGINE_READER_PASSWORD=engine-reader-dev

# Postgres on this machine (127.0.0.1 only), for database tools.
POSTGRES_PORT=5432

# The network engines join to reach these services.
SHARED_NETWORK=shared

# identity-mock (the `identity` profile): its port on this machine, the one
# client it knows (the engine's OIDC_CLIENT_ID and OIDC_CLIENT_SECRET), and
# the address its sign-in form starts with.
IDENTITY_MOCK_PORT=9100
IDENTITY_MOCK_CLIENT_ID=engine-dev
IDENTITY_MOCK_CLIENT_SECRET=engine-dev-secret
IDENTITY_MOCK_EMAIL=dev@example.com
