# The runner's settings (the Python sandbox). Copy to runner.env.
# Never put credentials here: scripts run beside it.

RUN_TIMEOUT_SECONDS=60
RUN_MEMORY_MB=1536
RUN_MAX_OUTPUT_CHARS=200000
# Runs at once per runner container. Keep 1 (concurrent runs share a user, so
# could read each other's scratch files); add replicas for more.
RUN_CONCURRENCY=1
