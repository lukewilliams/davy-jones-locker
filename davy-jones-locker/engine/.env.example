# The engine's settings. Copy to .env (which isn't committed) and fill in.
# The runner has its own file (runner.env.example): nothing here reaches it.

# IS_LOCAL (true for local development) is compose's setting, not this
# file's: compose.yaml passes it to the engine and uses it for the node
# worker's network (see ../.env.example). Running the engine without Docker,
# set IS_LOCAL=true in the environment. Without it the engine counts as
# deployed, and starts only with sign-in (below).

# Sign-in: none (local development only, and its default there), oidc, or
# header. Every endpoint but /health and /auth/* then needs a signed-in user
# whom ALLOWED_USERS names. See the README, "Sign-in".
# IDENTITY=oidc
# Who may use the engine: email patterns (*@example.com, or one address) and
# groups (group:<id>), comma-separated.
# ALLOWED_USERS=*@example.com
# Where browsers reach the engine, with its path: the app's origin plus
# /engines/<service>. Sign-in comes back to PUBLIC_URL/auth/callback.
# PUBLIC_URL=https://app.example.com/engines/engine
# Encrypts the session cookie and each user's saved b. settings: 32 or more
# random characters (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Changing it signs everyone out and loses their saved settings.
# SECRET_KEY=
# SESSION_HOURS=8

# OIDC: the provider's discovery document, and the engine's client there
# (a confidential client; its redirect address PUBLIC_URL/auth/callback).
# With engine-shared's identity-mock (its `identity` profile), on this machine:
#   OIDC_DISCOVERY_URL=http://identity-mock:3000/.well-known/openid-configuration
#   OIDC_CLIENT_ID=engine-dev
#   OIDC_CLIENT_SECRET=engine-dev-secret
# OIDC_DISCOVERY_URL=https://login.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# The claim ALLOWED_USERS matches (empty: email, then preferred_username), and
# the one with the user's groups.
# OIDC_EMAIL_CLAIM=
# OIDC_GROUPS_CLAIM=groups

# Trusted headers: a proxy in front signs users in and sets these on every
# request (replacing any the browser sent). The engine believes them only
# with IDENTITY_SECRET in IDENTITY_SECRET_HEADER, or from
# IDENTITY_TRUSTED_PROXIES (addresses or networks), or both: set one.
# IDENTITY_HEADER_USER=X-Forwarded-User
# IDENTITY_HEADER_EMAIL=X-Forwarded-Email
# IDENTITY_HEADER_NAME=X-Forwarded-Preferred-Username
# IDENTITY_HEADER_GROUPS=X-Forwarded-Groups
# IDENTITY_SECRET=
# IDENTITY_SECRET_HEADER=X-Identity-Secret
# IDENTITY_TRUSTED_PROXIES=
# Where signing out sends the browser (the proxy's own sign-out).
# IDENTITY_LOGOUT_URL=

# Postgres, for saved graphs, stored files and run records, and for SQL nodes
# that read your own tables. Off until you set DATABASE_URL: those endpoints
# answer 503, and everything else works. With engine-shared (its .env has
# these roles and passwords), start it, uncomment the `shared` network lines
# in compose.yaml, and uncomment the two URLs below. The engine's tables go in
# schema FLOW_SCHEMA, created the first time the database answers.
# DATABASE_URL=postgresql://engine:engine-dev@postgres:5432/flow
FLOW_SCHEMA=flow

# The database server-side SQL reads (attached read-only as "db"), through a
# read-only role (engine-shared/postgres/engine-roles.sql makes one).
# Empty: DATABASE_URL, whose role can read the engine's own tables too.
# QUERY_DATABASE_URL=postgresql://engine_reader:engine-reader-dev@postgres:5432/flow

# What /health reports as the engine's address (the app shows it). The app's
# compose.yaml usually sets it to the engine's service name.
PUBLIC_HOST=engine

# Limits for SQL on the server, and for uploads.
QUERY_TIMEOUT_SECONDS=60
QUERY_MEMORY_LIMIT=1GB
MAX_UPLOAD_MB=200

# How long the engine waits for the runner (it adds 30s for transfer).
RUN_TIMEOUT_SECONDS=60

# Loops and jobs: the most runs of one Loop at once (whatever its node asks),
# the most jobs running at once, and how long a finished job's result is kept.
LOOP_MAX_CONCURRENCY=4
JOBS_AT_ONCE=4
JOB_KEEP_SECONDS=3600

# The runner's requirements.in, when the app's runner adds libraries (a path
# in the engine's image): the assistant reads it to know what scripts can
# import. Empty: the framework's.
# RUNNER_PACKAGES_FILE=/srv/runner-requirements.in

# The node worker, for the app's own node kinds (compose.yaml sets it when the
# app has one). The engine refuses every request from the runner's and the
# node worker's addresses; SANDBOX_HOSTS names any other hosts to refuse
# (comma-separated).
# NODE_WORKER_URL=http://node-worker:3000
# SANDBOX_HOSTS=

# The AI assistant in Manage (SQLQuery, PythonScript, JavaScript nodes), through
# a LiteLLM proxy. Off unless all three settings below are set. The key stays on
# the engine: the browser never sees it, and the runner can't read it.
# LITELLM_BASE_URL is the proxy's address (with /v1 or without); requests go to
# its /chat/completions. ASSIST_MODEL is a model name the proxy offers
# (there's no default: GET /models on the proxy, with the key, lists them).
LITELLM_BASE_URL=
LITELLM_API_KEY=
ASSIST_MODEL=
# Rows of each input sent with a request, as examples of its values (0: none,
# just column names and types).
ASSIST_SAMPLE_ROWS=3
ASSIST_TIMEOUT_SECONDS=90
