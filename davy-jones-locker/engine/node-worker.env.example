# The node worker's settings (it runs the app's own node kinds). Copy to
# node-worker.env. Never put credentials here: the worker holds none, by design.

# The app's list of node kinds, "module:attribute" (usually set in the app's
# worker image instead).
# NODE_KINDS=nodes:KINDS
# Runs at once. Each is a process of its own, killed at its kind's timeout_s.
NODE_CONCURRENCY=2
# Memory per run, in MB (as address space, doubled for allocators' reservations).
NODE_MEMORY_MB=2048
