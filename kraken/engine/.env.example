# engine-kraken's settings. Copy to .env (which isn't committed) and fill in.
# The runner has its own file (runner.env.example): nothing here reaches it.
# compose's own IS_LOCAL is kraken/.env's (kraken/.env.example).

# Local development: the engine may sign no one in (unless IDENTITY below
# says otherwise), and an app's node kinds can reach the network. Keep it on
# your own machine. Without IS_LOCAL=true the engine counts as deployed, and
# starts only with sign-in.
IS_LOCAL=true

# Sign-in (the engine README, "Sign-in"). Off while IS_LOCAL is true and
# IDENTITY is unset. With any OpenID Connect provider: register the engine as
# a web application (a confidential client), its redirect address
# PUBLIC_URL/auth/callback, with a client secret.
# IDENTITY=oidc
# ALLOWED_USERS=*@example.com
# PUBLIC_URL=https://kraken.example.com/engines/engine-kraken
# SECRET_KEY=<48 random characters>
# OIDC_DISCOVERY_URL=https://<your provider>/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# To try sign-in on this machine with engine-shared's identity-mock (start it
# with `--profile identity`), and the app on 8130:
# IDENTITY=oidc
# ALLOWED_USERS=*@example.com
# PUBLIC_URL=http://localhost:8130/engines/engine-kraken
# SECRET_KEY=<48 random characters>
# OIDC_DISCOVERY_URL=http://identity-mock:3000/.well-known/openid-configuration
# OIDC_CLIENT_ID=engine-dev
# OIDC_CLIENT_SECRET=engine-dev-secret

# Postgres (engine-shared's, by default: set its .env to match, with
# ENGINE_USER=engine_kraken and ENGINE_READER=engine_kraken_reader and these
# passwords). The engine's own tables (graphs, stored files, runs) go in schema
# FLOW_SCHEMA, created on startup. Without DATABASE_URL, those endpoints answer
# 503; /query and /run/python still work.
DATABASE_URL=postgresql://engine_kraken:engine-kraken-dev@postgres:5432/flow
FLOW_SCHEMA=flow

# The database server-side SQL reads (attached read-only as "db"), through a
# read-only role (davy-jones-locker/engine-shared/postgres/engine-roles.sql makes one).
# Empty: DATABASE_URL, whose role can read the engine's own tables too.
QUERY_DATABASE_URL=postgresql://engine_kraken_reader:engine-kraken-reader-dev@postgres:5432/flow

# Limits for SQL on the server, and for uploads.
QUERY_TIMEOUT_SECONDS=60
QUERY_MEMORY_LIMIT=1GB
MAX_UPLOAD_MB=200

# How long the engine waits for the runner (it adds 30s for transfer).
RUN_TIMEOUT_SECONDS=60

# Loops and jobs: the most runs of one Loop at once (whatever its node asks),
# the most jobs running at once, and how long a finished job's result is kept.
LOOP_MAX_CONCURRENCY=4
JOBS_AT_ONCE=4
JOB_KEEP_SECONDS=3600

# The AI assistant in Manage (SQLQuery, PythonScript, JavaScript nodes), through
# a LiteLLM proxy. Off unless all three settings below are set. The key stays on
# the engine: the browser never sees it, and the runner can't read it.
# LITELLM_BASE_URL is the proxy's address (with /v1 or without); requests go to
# its /chat/completions. ASSIST_MODEL is a model name the proxy offers
# (there's no default: GET /models on the proxy, with the key, lists them).
LITELLM_BASE_URL=
LITELLM_API_KEY=
ASSIST_MODEL=
# Rows of each input sent with a request, as examples of its values (0: none,
# just column names and types).
ASSIST_SAMPLE_ROWS=3
ASSIST_TIMEOUT_SECONDS=90
