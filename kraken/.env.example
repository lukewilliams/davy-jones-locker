# compose's own settings for KRAKEN (copy to .env beside compose.yaml; not
# committed). IS_LOCAL must be exactly true or false: true is local
# development (see engine/.env.example).
IS_LOCAL=true

# The address the app's port (8130) is published on. 127.0.0.1: this machine
# only. With IS_LOCAL=true the engine signs no one in, so anyone who reached
# the app could run Python and SQL. Change it only with sign-in on.
APP_BIND=127.0.0.1
